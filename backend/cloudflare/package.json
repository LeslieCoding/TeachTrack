{
  "name": "teachtrack-cloudflare-backend",
  "version": "4.0.0-alpha.1",
  "private": true,
  "type": "module",
  "scripts": {
    "schema": "python tools/build-schema.py",
    "dev": "wrangler dev --local",
    "migrate:local": "wrangler d1 migrations apply teachtrack --local",
    "migrate:remote": "wrangler d1 migrations apply teachtrack --remote",
    "deploy": "npm run typecheck && wrangler deploy",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "^1.6.0",
    "@cloudflare/workers-types": "^5.20261104.1",
    "@types/node": "^22.20.5",
    "@vitest/runner": "^4.1.0",
    "@vitest/snapshot": "^4.1.0",
    "typescript": "^5.9.3",
    "vitest": "^4.1.0",
    "wrangler": "4.158.0"
  },
  "dependencies": {
    "@pdf-lib/fontkit": "^1.1.1",
    "docx": "^9.15.2",
    "pdf-lib": "^1.17.1"
  }
}
