# TeachTrack backend — copy to .env and fill in. Never commit real secrets.

# --- Database (development default: portable PostgreSQL on 55432) ---
TEACHTRACK_DB_URL=jdbc:postgresql://127.0.0.1:55432/teachtrack
TEACHTRACK_DB_USER=teachtrack
TEACHTRACK_DB_PASSWORD=

# --- Cloud database (used by run-cloud.ps1 / run-cloud.sh / migrate-to-cloud.sh) ---
# Supabase example (use SESSION POOLER, port 5432):
# TEACHTRACK_DB_URL=jdbc:postgresql://aws-0-ap-southeast-1.pooler.supabase.com:5432/postgres?sslmode=require
# TEACHTRACK_DB_USER=postgres.<project-ref>
# TEACHTRACK_DB_PASSWORD=<database-password>
# CLOUD_DB_URL=postgresql://postgres.<project-ref>:<database-password>@aws-0-ap-southeast-1.pooler.supabase.com:5432/postgres?sslmode=require
CLOUD_DB_URL=

# --- Bootstrap owner token (only used when api_tokens is empty) ---
# Generate with: openssl rand -base64 32
TEACHTRACK_BOOTSTRAP_TOKEN=replace-with-a-long-random-token

# --- Object storage ---
# local | s3
TEACHTRACK_STORAGE_PROVIDER=local
TEACHTRACK_STORAGE_ROOT=./data/storage
# Required for signed URLs. If empty in dev, a random secret is generated per start.
TEACHTRACK_STORAGE_SECRET=replace-with-a-long-random-secret

# For TEACHTRACK_STORAGE_PROVIDER=s3
TEACHTRACK_S3_ENDPOINT=
TEACHTRACK_S3_REGION=auto
TEACHTRACK_S3_BUCKET=
TEACHTRACK_S3_ACCESS_KEY=
TEACHTRACK_S3_SECRET_KEY=

# --- AI providers (M05+, leave empty until then) ---
TEACHTRACK_AI_PROVIDER=mock
TEACHTRACK_OPENAI_API_KEY=
TEACHTRACK_OPENAI_BASE_URL=https://api.openai.com/v1
TEACHTRACK_KIMI_API_KEY=

# --- Baidu Netdisk as object storage (files only, not the database) ---
# Requires: pip install bypy && bypy info (one-time browser authorization)
TEACHTRACK_STORAGE_PROVIDER=local
TEACHTRACK_BYPY=bypy
TEACHTRACK_BAIDU_ROOT=teachtrack
TEACHTRACK_BAIDU_TIMEOUT=120
